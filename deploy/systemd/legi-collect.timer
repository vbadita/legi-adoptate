[Unit]
Description=Collect laws once a day, in the evening after the plenary sittings (Bucharest time)

[Timer]
# One run a day: the day's votes are in, so "adopted today" is complete the
# same evening. Persistent: a run missed while the VM was down happens at boot.
OnCalendar=*-*-* 20:30 Europe/Bucharest
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
